NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile (spam protection for the contact and newsletter forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFYenQ_HreJ9soTo
# Secret key from the Cloudflare dashboard (Turnstile > your widget). Never commit the real value.
TURNSTILE_SECRET=
# Comma-separated hostnames allowed to submit, e.g. atlasstudio.com,www.atlasstudio.com
# Do not include localhost in production.
TURNSTILE_HOSTNAMES=
